# ==============================================================================
# DueFlow Production & Local Environment Configuration
# ==============================================================================

# Core Application Settings
PORT=8080
NODE_ENV=development
APP_BASE_URL="http://localhost:3000"

# Frontend Vite Variables (Publicly exposed in browser bundle)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
VITE_SUPABASE_ANON_KEY="sb_publishable_your_key"
VITE_API_URL="http://localhost:8080"

# Server-Only Supabase Configuration (Never exposed to the frontend)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_your_key"
SUPABASE_SECRET_KEY="sb_secret_your_service_role_key"

# Database Persistence (Supabase / PostgreSQL connection pool URL for Java backend)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# When omitted, DueFlow runs in resilient in-memory PostgreSQL mode for local test suites.
DATABASE_URL="postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres"

# Connected Email Providers (OAuth 2.0 via User's Gmail or Outlook)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
MICROSOFT_CLIENT_ID="your_microsoft_client_id"
MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret"

# Google Gemini AI Configuration (Deterministic fallback activated if omitted)
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.8-flash"

# Background Cron & Scheduled Worker Invocation Secret
CRON_SECRET="dueflow_cron_dev_secret_2026"
