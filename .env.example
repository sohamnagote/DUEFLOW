# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
SUPABASE_SECRET_KEY="sb_secret_your_service_key"

# Outbound Email Delivery (Resend)
RESEND_API_KEY="re_your_api_key"
RESEND_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"
RESEND_FROM_EMAIL="DueFlow Reminders <reminders@dueflow.in>"

# Background Cron / Worker Invocation Secret
CRON_SECRET="your_secure_cron_invocation_secret"

# Google Gemini AI Configuration
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.8-flash"

# Application Base URL
APP_BASE_URL="http://localhost:3000"
